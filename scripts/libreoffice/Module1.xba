    oDoc = oDesk.loadComponentFromURL(inUrl, "_blank", 0, args())
    oSheets = oDoc.getSheets()
    For i = 0 To oSheets.getCount() - 1
        oSheet = oSheets.getByIndex(i)
        If Left(oSheet.getName(), 4) = "TM -" Then
            anchor = -1
            For r = 5 To 35
                oCell = oSheet.getCellByPosition(0, r)
                If InStr(oCell.getString(), "Comped Members") &gt; 0 Then
                    anchor = r
                    Exit For
                End If
            Next r
            If anchor &gt;= 0 Then
                oSheet.getRows().insertByIndex(anchor + 1, 1)
            End If
        End If
    Next i
    Dim sargs(0) As New com.sun.star.beans.PropertyValue
    sargs(0).Name = "FilterName" : sargs(0).Value = "Calc MS Excel 2007 XML"
    oDoc.storeToURL(outUrl, sargs())
    oDoc.close(False)
End Sub

Sub AddLocationLines(inUrl As String, outUrl As String)
    Dim oDesk, oDoc, oSheets, oSheet, oCell
    Dim i%, r%, ntRow%, tRow%, cRow%
    Dim s As String
    oDesk = createUnoService("com.sun.star.frame.Desktop")
    Dim args(0) As New com.sun.star.beans.PropertyValue
    args(0).Name = "Hidden" : args(0).Value = True
    oDoc = oDesk.loadComponentFromURL(inUrl, "_blank", 0, args())
    oSheets = oDoc.getSheets()
    For i = 0 To oSheets.getCount() - 1
        oSheet = oSheets.getByIndex(i)
        If Left(oSheet.getName(), 4) = "TM -" Then
            ntRow = -1 : tRow = -1 : cRow = -1
            For r = 4 To 140
                s = oSheet.getCellByPosition(0, r).getString()
                If s = "Hospitality Non-Target (#)" Then ntRow = r
                If s = "Hospitality Target (#)" Then tRow = r
                If InStr(s, "Hospitality Combined") &gt; 0 Then cRow = r
            Next r
            If ntRow &gt; 0 And tRow &gt; 0 And cRow &gt; 0 Then
                oSheet.getRows().insertByIndex(ntRow + 1, 1)
                oSheet.getRows().insertByIndex(tRow + 1, 1)
                oSheet.getRows().insertByIndex(cRow + 1, 1)
            End If
        End If
    Next i
    Dim sargs(0) As New com.sun.star.beans.PropertyValue
    sargs(0).Name = "FilterName" : sargs(0).Value = "Calc MS Excel 2007 XML"
    oDoc.storeToURL(outUrl, sargs())
    oDoc.close(False)
End Sub


