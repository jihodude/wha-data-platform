<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE script:module PUBLIC "-//OpenOffice.org//DTD OfficeDocument 1.0//EN" "module.dtd">
<script:module xmlns:script="http://openoffice.org/2000/script" script:name="Module1" script:language="StarBasic">
Sub ReorderTM2(inUrl As String, outUrl As String)
    Dim oDesk, oDoc, oSheets, oSheet, oCell
    Dim i%, r%, b0%, src%
    oDesk = createUnoService("com.sun.star.frame.Desktop")
    Dim args(0) As New com.sun.star.beans.PropertyValue
    args(0).Name = "Hidden" : args(0).Value = True
    oDoc = oDesk.loadComponentFromURL(inUrl, "_blank", 0, args())
    oSheets = oDoc.getSheets()
    For i = 0 To oSheets.getCount() - 1
        oSheet = oSheets.getByIndex(i)
        If Left(oSheet.getName(), 4) = "TM -" Then
            b0 = -1
            For r = 80 To 200
                oCell = oSheet.getCellByPosition(0, r)
                If InStr(oCell.getString(), "TARGET + NON-TARGET") &gt; 0 Then
                    b0 = r
                    Exit For
                End If
            Next r
            If b0 &gt;= 0 Then
                oSheet.getRows().insertByIndex(5, 21)
                src = b0 + 21
                Dim oRange, oDest
                oRange = oSheet.getCellRangeByPosition(0, src, 43, src + 19).getRangeAddress()
                oDest = oSheet.getCellByPosition(0, 5).getCellAddress()
                oSheet.moveRange(oDest, oRange)
                oSheet.getRows().removeByIndex(src, 20)
            End If
        End If
    Next i
    Dim sargs(0) As New com.sun.star.beans.PropertyValue
    sargs(0).Name = "FilterName" : sargs(0).Value = "Calc MS Excel 2007 XML"
    oDoc.storeToURL(outUrl, sargs())
    oDoc.close(False)
End Sub

Sub AddCompLines(inUrl As String, outUrl As String)
    Dim oDesk, oDoc, oSheets, oSheet, oCell
    Dim i%, r%, bobRow%, revRow%
    oDesk = createUnoService("com.sun.star.frame.Desktop")
    Dim args(0) As New com.sun.star.beans.PropertyValue
    args(0).Name = "Hidden" : args(0).Value = True
    oDoc = oDesk.loadComponentFromURL(inUrl, "_blank", 0, args())
    oSheets = oDoc.getSheets()
    For i = 0 To oSheets.getCount() - 1
        oSheet = oSheets.getByIndex(i)
        If Left(oSheet.getName(), 4) = "TM -" Then
            bobRow = -1 : revRow = -1
            For r = 5 To 30
                oCell = oSheet.getCellByPosition(0, r)
                If InStr(oCell.getString(), "BOB ($)") &gt; 0 And bobRow = -1 Then
                    bobRow = r
                End If
                If InStr(oCell.getString(), "Revenue Retained") &gt; 0 And revRow = -1 Then
                    revRow = r
                End If
            Next r
            If bobRow &gt;= 0 And revRow &gt; bobRow Then
                oSheet.getRows().insertByIndex(bobRow + 1, 1)
                oSheet.getRows().insertByIndex(revRow + 2, 2)
            End If
        End If
    Next i
    Dim sargs(0) As New com.sun.star.beans.PropertyValue
    sargs(0).Name = "FilterName" : sargs(0).Value = "Calc MS Excel 2007 XML"
    oDoc.storeToURL(outUrl, sargs())
    oDoc.close(False)
End Sub

Sub AddBobLine(inUrl As String, outUrl As String)
    Dim oDesk, oDoc, oSheets, oSheet, oCell
    Dim i%, r%, anchor%
    oDesk = createUnoService("com.sun.star.frame.Desktop")
