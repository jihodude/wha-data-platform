# WHA Data Platform — environment template
# Copy to `.env` and fill in real values. NEVER commit the real .env.

# --- SLX (Infor CRM) SData credentials -------------------------------------
# A dedicated read-only CRM login. One session at a time — two processes
# sharing this login collide and log each other out.
SLX_USERNAME=
SLX_PASSWORD=

# --- SharePoint (Microsoft Graph app registration) -------------------------
# App-only credentials for the SP site that hosts Reports/ and the hub.
SHAREPOINT_SITE_URL=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_SECRET=

# Legacy aliases (some modules still read the AZURE_* names — keep both
# pairs identical until the rename lands).
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_SECRET=

# --- Optional runtime switches ---------------------------------------------
# MPR_PERIOD=YYYY-MM   pin the reporting period (default: newest with data)
# MPR_PUBLISH=1        force publish to SharePoint (0 holds everything off SP)
APP_PASSWORD=choose-a-real-password   # console login gate; set in cloud env too

# Optional dev toggles (never needed in production):
# WHA_OFFLINE=1          skip all SharePoint access (pure-local work)
# WHA_SKIP_SP_REFRESH=1  console: don't re-sync the cache from SharePoint
